PORT=5001

# Local MongoDB
MONGO_URL=mongodb://localhost:27017
DB_NAME=unque

# Amazon DocumentDB: use the cluster endpoint (not an instance endpoint),
# and keep credentials and the database name out of the URL.
# MONGO_URL=mongodb://<cluster-endpoint>:27017/?tls=true&replicaSet=rs0&retryWrites=false
# DB_USER=
# DB_PASSWORD=
# DB_CA_FILE=/opt/unque/certs/global-bundle.pem

# at least 32 characters, generate one with: openssl rand -hex 32
JWT_SECRET=replace-me